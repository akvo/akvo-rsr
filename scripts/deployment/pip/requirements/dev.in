# Include production requirements
-r production.in

# Linting
flake8

# for parallel tests
tblib

# for parameterized tests
parameterized

# Debug perf
django-debug-toolbar

# Documentation
# Sphinx 9 rewrote autodoc to call repr() on class attributes. The 75 DRF viewsets in
# akvo/rest/views each hold a `queryset` class attribute, and QuerySet.__repr__ evaluates
# the query, so generating the docs would run 75 queries against whatever database happens
# to be configured - and fails outright when that database has no schema, as in the Pages
# workflow. Held at 8.x until those attributes are hidden from autodoc.
Sphinx<9
sphinx_rtd_theme
sphinxcontrib-plantuml
# Sphinx markdown support
# https://www.sphinx-doc.org/en/master/usage/markdown.html
myst-parser

# Better shell
ipython

# Better debug tracing
ipdb

# For generating requirements files
pip-tools

# coverage test
coverage
coveralls
# Highlight coverage between the diff of your branch and another one
diff_cover

# easy test factory generation
factory-boy

# Profiling packages
django-cprofile-middleware
snakeviz
